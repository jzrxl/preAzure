{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/cat.txt",
    "padding": { "left": 3, "right": 5 }
  },
  "display": {
    "separator": " :: ",
    "color": {
      "keys": "magenta",
      "values": "white",
      "separator": "cyan"
    }
  },
  "modules": [
    { "type": "os",      "key": "OS" },
    { "type": "host",    "key": "Host" },
    { "type": "command", "key": "Kernel", "text": "uname -r | cut -d'-' -f1" },
    { "type": "uptime",  "key": "Uptime" },
    { "type": "cpu",     "key": "CPU" },
    { "type": "gpu",     "key": "GPU" },
    { "type": "memory",  "key": "Memory" },
    { "type": "command", "key": "Storage",
      "text": "df -h /storage/emulated | tail -1 | awk '{print $3 \" / \" $2 \" (\" $5 \")\"}'" },
    { "type": "battery", "key": "Battery", "format": "{capacity}% [{status}]" }
  ]
}
