#!/data/data/com.termux/files/usr/bin/bash
# preAzure · Termux fetch dashboard

clear

# ── Greeting ──
hour=$(date +%H); hour=${hour#0}; [ -z "$hour" ] && hour=0
minute=$(date +%M); ampm=$(date +%p)
hour12=$((hour % 12)); [ "$hour12" -eq 0 ] && hour12=12
time="$hour12:$minute $ampm"

RESET='\e[0m'
TIME_COLOR='\e[38;5;118m'

if   [ "$hour" -ge 5 ]  && [ "$hour" -lt 12 ]; then GREET_COLOR='\e[38;5;220m'; greet_word="Good Morning"
elif [ "$hour" -ge 12 ] && [ "$hour" -lt 17 ]; then GREET_COLOR='\e[38;5;208m'; greet_word="Good Afternoon"
elif [ "$hour" -ge 17 ] && [ "$hour" -lt 22 ]; then GREET_COLOR='\e[38;5;177m'; greet_word="Good Evening"
else                                                  GREET_COLOR='\e[38;5;111m'; greet_word="Good Night"
fi

echo ""
echo -e "  ${GREET_COLOR}${greet_word}${RESET}, Nigga. It's ${TIME_COLOR}${time}${RESET}"
echo ""

# ── Random cat ──
CATS_DIR="$HOME/.config/fastfetch/cats"
CAT_FILE="$HOME/.config/fastfetch/cat.txt"
if [ -d "$CATS_DIR" ]; then
    mapfile -t cats < <(ls "$CATS_DIR"/*.txt 2>/dev/null)
    if [ ${#cats[@]} -gt 0 ]; then
        pick=${cats[$((RANDOM % ${#cats[@]}))]}
        cp "$pick" "$CAT_FILE"
    fi
fi

# ── System info ──
fastfetch

# ── Random quote (wrapped, centered, neon green) ──
QUOTE=$(~/.local/bin/quote 2>/dev/null)
if [ -n "$QUOTE" ]; then
    echo ""
    WIDTH=$(tput cols 2>/dev/null || echo 60)
    WRAP=$((WIDTH - 8))
    echo "\"$QUOTE\"" | fold -s -w "$WRAP" | while IFS= read -r line; do
        len=${#line}
        pad=$(( (WIDTH - len) / 2 ))
        [ "$pad" -lt 0 ] && pad=0
        printf '%*s\e[38;5;118m%s\e[0m\n' "$pad" "" "$line"
    done
fi
echo
