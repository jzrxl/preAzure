#!/data/data/com.termux/files/usr/bin/bash

GREET_NAME="friend"
TIME_COLOR=118
GREET_MORNING_COLOR=220
GREET_AFTERNOON_COLOR=208
GREET_EVENING_COLOR=177
GREET_NIGHT_COLOR=111
JOKE_COLOR=118
JOKE_ENABLED=1
CAT_ENABLED=1
JOKE_TTL=300

CONFIG="$HOME/.config/preAzure/config.sh"
[ -f "$CONFIG" ] && . "$CONFIG"

RESET='\e[0m'
TIME_SEQ="\e[38;5;${TIME_COLOR}m"
MORN_SEQ="\e[38;5;${GREET_MORNING_COLOR}m"
AFT_SEQ="\e[38;5;${GREET_AFTERNOON_COLOR}m"
EVE_SEQ="\e[38;5;${GREET_EVENING_COLOR}m"
NGT_SEQ="\e[38;5;${GREET_NIGHT_COLOR}m"
JOKE_SEQ="\e[38;5;${JOKE_COLOR}m"

clear

hour=$(date +%H); hour=${hour#0}; [ -z "$hour" ] && hour=0
minute=$(date +%M); ampm=$(date +%p)
hour12=$((hour % 12)); [ "$hour12" -eq 0 ] && hour12=12
time="$hour12:$minute $ampm"

if   [ "$hour" -ge 5 ]  && [ "$hour" -lt 12 ]; then GREET_SEQ="$MORN_SEQ"; greet_word="Good Morning"
elif [ "$hour" -ge 12 ] && [ "$hour" -lt 17 ]; then GREET_SEQ="$AFT_SEQ";  greet_word="Good Afternoon"
elif [ "$hour" -ge 17 ] && [ "$hour" -lt 22 ]; then GREET_SEQ="$EVE_SEQ";  greet_word="Good Evening"
else                                                  GREET_SEQ="$NGT_SEQ";  greet_word="Good Night"
fi

echo ""
echo -e "  ${GREET_SEQ}${greet_word}${RESET}, ${GREET_NAME}. It's ${TIME_SEQ}${time}${RESET}"
echo ""

if [ "$CAT_ENABLED" -eq 1 ]; then
    CATS_DIR="$HOME/.config/fastfetch/cats"
    CAT_FILE="$HOME/.config/fastfetch/cat.txt"
    if [ -d "$CATS_DIR" ]; then
        mapfile -t cats < <(ls "$CATS_DIR"/*.txt 2>/dev/null)
        if [ ${#cats[@]} -gt 0 ]; then
            pick=${cats[$((RANDOM % ${#cats[@]}))]}
            cp "$pick" "$CAT_FILE"
        fi
    fi
fi

fastfetch

if [ "$JOKE_ENABLED" -eq 1 ]; then
    JOKE_CACHE="$HOME/.cache/preAzure_joke"

    mkdir -p "$(dirname "$JOKE_CACHE")"

    need_fetch=1
    if [ -f "$JOKE_CACHE" ]; then
        age=$(( $(date +%s) - $(stat -c %Y "$JOKE_CACHE" 2>/dev/null || echo 0) ))
        [ "$age" -lt "$JOKE_TTL" ] && need_fetch=0
    fi

    if [ "$need_fetch" -eq 1 ]; then
        curl -sf --max-time 3 \
            -H "Accept: application/json" \
            https://icanhazdadjoke.com/ \
          | jq -r '.joke // empty' > "$JOKE_CACHE.tmp" 2>/dev/null \
          && mv "$JOKE_CACHE.tmp" "$JOKE_CACHE"
    fi

    JOKE=$(cat "$JOKE_CACHE" 2>/dev/null)

    if [ -n "$JOKE" ]; then
        COLS=$(tput cols 2>/dev/null || echo 80)
        [ "$COLS" -lt 40 ] && COLS=40

        WRAP=$((COLS - 12))
        [ "$WRAP" -lt 30 ] && WRAP=30

        echo ""

        while IFS= read -r line; do
            [ -z "$line" ] && { echo ""; continue; }
            pad=$(( (COLS - ${#line}) / 2 ))
            [ "$pad" -lt 0 ] && pad=0
            printf "%${pad}s%b%s%b\n" "" "$JOKE_SEQ" "$line" "$RESET"
        done < <(printf '%s' "$JOKE" | fold -s -w "$WRAP")

        echo ""
    fi
fi
